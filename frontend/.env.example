# Optional. Only needed when the API server is started with AI_SHIELD_API_KEY set —
# this must match it exactly, or every request gets a 401. Leave unset for local dev
# against an API that also has no key configured (the default on both sides).
# VITE_API_KEY=

# Optional. Set this when the frontend is deployed separately from the API (e.g. this
# frontend on Vercel, the API on Docker/a VM) and there's no reverse proxy making "/api"
# resolve to the same origin. Point it at the API's origin, no trailing slash and no
# "/api" suffix (that's added automatically). Leave unset for local dev and Docker
# Compose, where "/api" is already proxied to the API for you.
# VITE_API_BASE_URL=https://your-api-host.example.com
