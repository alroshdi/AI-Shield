# Optional. The demo target (VulnBot) and the engine run fully offline and deterministically
# without any of this — see demo_target/persona.py. These are only for the stretch, non-default
# live-LLM path.
# ANTHROPIC_API_KEY=

# Optional. Requires an `X-API-Key` header on every request to `ai_shield serve`. Unset by
# default — fine for local development, but set this before exposing the web API beyond
# localhost. Must match frontend/.env's VITE_API_KEY exactly.
# AI_SHIELD_API_KEY=

# Optional. Comma-separated browser origins allowed to call the web API directly.
# Defaults to the Vite dev server's own origins; irrelevant to the dev proxy (same-origin
# from the browser's view) but matters once frontend and API are served separately.
# AI_SHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
